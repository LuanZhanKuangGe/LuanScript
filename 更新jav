import time
import json
import paramiko
from pathlib import Path
from tqdm import tqdm  # 导入tqdm模块

database = {'jav_id': [], 'fc2_id':[], 'fc2_time':0}

datapath = {}
datapath['fc2'] = Path(r"W:")

always_update = True

HD_PATH = Path(r"D:\AVHD")
FC2_PATH = Path(r"D:\AVFC2")
AVSD_PATH = Path(r"D:\AVSD")

for key in ['fc2']:
    with open("data-jav.json", "r", encoding="utf8") as fp:
        database_time = json.load(fp)[f'{key}_time']

        folder_time = datapath[key].stat().st_mtime
        print('数据时间:', time.ctime(database_time))
        print('目录时间:', time.ctime(folder_time))

        if folder_time > database_time or always_update:
            print(f'开始更新{key}')
            database[f'{key}_time'] = folder_time
            
            for video in tqdm(list(datapath[key].rglob("*.nfo")), desc=f"update {key} PATH"):
                video_id = video.stem.split(" ")[0]
                database[f'{key}_id'].append(video_id)
                if key == 'fc2':
                    video_id = video_id.replace('-', '-PPV-')
                    database[f'{key}_id'].append(video_id)
        else:
            print(f'跳过更新{key}')

    for item in database[f'{key}_id']:
        if item not in database['jav_id']:
            database['jav_id'].append(item)
        else:
            print(f'发现重复文件：{item}')

